{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["tests/**/*", "vitest.config.mts", "src/shared/**/*", "src/main/**/*"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node", "vitest/globals"]
  }
}
